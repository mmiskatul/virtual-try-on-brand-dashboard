NEXT_PUBLIC_BACKEND_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3001
# Marketplace site (links on the login/signup pages). Production: https://vtrystudio.com
NEXT_PUBLIC_MARKETPLACE_URL=http://localhost:3000
# Optional: server-to-server backend URL (defaults to NEXT_PUBLIC_BACKEND_API_URL)
# INTERNAL_BACKEND_API_URL=
# NextAuth JWT encryption secret (generate with: openssl rand -hex 32)
NEXTAUTH_SECRET=
# Optional: distributed rate limiting (Upstash Redis REST). Falls back to in-memory if unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Google OAuth 2.0 ("Continue with Google" / "Sign up with Google")
# Authorized Redirect URI in Google Cloud Console: http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

